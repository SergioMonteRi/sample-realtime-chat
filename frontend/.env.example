# URL base do backend Flask, usada pelo axios. Use `localhost` (e nao
# 127.0.0.1): o cookie de sessao do flask-login nasce SameSite=Lax, entao so
# viaja entre origens do mesmo site — porta diferente tudo bem, host diferente
# nao. O backend precisa liberar esta origem com credenciais:
# `CORS(app, origins=["http://localhost:5173"], supports_credentials=True)`.
VITE_API_BASE_URL=http://localhost:5001

# --- Reservado para a fase de tempo real (Socket.IO ainda nao integrado) ---
# Origem do servidor Socket.IO: o mesmo Flask que serve o REST.
VITE_SOCKET_URL=http://localhost:5001
# Caminho do Engine.IO. O Flask-SocketIO atende em /socket.io por padrao.
VITE_SOCKET_PATH=/socket.io

# development | staging | production
VITE_APP_ENV=development
